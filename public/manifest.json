{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "PXH Dubbing YooToob",
  "version": "0.1.0",
  "description": "Lồng tiếng Việt thông minh cho video YouTube với độ trễ thấp.",
  "icons": { "16": "icons/pxh-16.png", "32": "icons/pxh-32.png", "48": "icons/pxh-48.png", "128": "icons/pxh-128.png" },
  "permissions": ["storage", "activeTab", "tabCapture", "offscreen", "tts"],
  "host_permissions": ["https://www.youtube.com/*", "https://api.groq.com/*", "http://localhost:3000/*", "https://pxh-dubbing-yoo-toob.vercel.app/*"],
  "action": { "default_popup": "popup.html", "default_title": "PXH Dubbing YooToob", "default_icon": { "16": "icons/pxh-16.png", "32": "icons/pxh-32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
